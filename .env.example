# Mauritius Quest — variables d'environnement
# Copie ce fichier en .env.local. Ne commite jamais de vraie valeur.
# Phase 0 : aucune variable n'est requise.

# --- Navigateur (exposées au client) ---
# Clé Maps JS, restreinte par référent HTTP et par API (Maps JavaScript API seulement)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL publique de l'app, sans barre finale
NEXT_PUBLIC_APP_URL=

# --- Serveur uniquement (jamais de préfixe NEXT_PUBLIC_) ---
# Routes API et Places API
GOOGLE_MAPS_SERVER_KEY=
# Scripts et serveur uniquement
SUPABASE_SERVICE_ROLE_KEY=
# Taux roupie mauricienne / euro — source à valider (voir docs/DECISIONS.md)
EXCHANGE_RATE_API_URL=
# openrouteservice, seulement s'il est retenu pour la matrice de trajets
ORS_API_KEY=
